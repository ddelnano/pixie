'''Object Container Histogram

Visualizes container element count distributions from Object Introspection data.

'''
import px


def container_histogram(start_time: str, container_path: str):
    df = px.DataFrame(table='object_container_stats', start_time=start_time)
    df = df[px.contains(df.container_path, container_path)]
    df.binned_count = px.bin(df.element_count, 10)
    df = df.groupby('binned_count').agg(count=('element_count', px.count))
    return df
