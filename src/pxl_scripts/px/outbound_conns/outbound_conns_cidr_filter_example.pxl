''' Outbound Connections with Corporate CIDR Filtering

This script lists connections made to IPs outside the k8s cluster,
with the ability to filter out (or label) known internal corporate network ranges.
'''
import px


# Define your internal corporate CIDR ranges as a JSON array.
# Update these with your actual CIDR ranges.
internal_cidrs = '["10.0.0.0/17", "10.0.128.0/17", "128.0.0.0/16", "10.10.10.0/26", "10.10.10.64/26", "10.1.0.0/17", "10.1.128.0/17", "130.0.0.0/17", "130.0.128.0/17", "162.0.0.0/17", "162.0.128.0/17", "130.1.0.0/23", "130.1.2.0/23"]'


def label_network(remote_addr):
    '''Maps a remote IP address to a human-readable network name using CIDR matching.'''
    return px.select(
        px.cidrs_contain_ip('["10.0.0.0/17"]', remote_addr), 'UK-SITE-01',
        px.select(
            px.cidrs_contain_ip('["10.0.128.0/17"]', remote_addr), 'UK-SITE-02',
            px.select(
                px.cidrs_contain_ip('["128.0.0.0/16"]', remote_addr), 'HERITAGE-XSITE-01',
                px.select(
                    px.cidrs_contain_ip('["10.10.10.0/26"]', remote_addr), 'UK-NONNAT-01',
                    px.select(
                        px.cidrs_contain_ip('["10.10.10.64/26"]', remote_addr), 'UK-NONNAT-02',
                        px.select(
                            px.cidrs_contain_ip('["10.1.0.0/17"]', remote_addr), 'HK-SITE-01',
                            px.select(
                                px.cidrs_contain_ip('["10.1.128.0/17"]', remote_addr), 'HK-SITE-02',
                                px.select(
                                    px.cidrs_contain_ip('["130.0.0.0/17"]', remote_addr), 'HK-DRN-STRETCHED-01',
                                    px.select(
                                        px.cidrs_contain_ip('["130.0.128.0/17"]', remote_addr), 'HK-DRN-STRETCHED-02',
                                        px.select(
                                            px.cidrs_contain_ip('["162.0.0.0/17"]', remote_addr), 'US-DRN-STRETCHED-01',
                                            px.select(
                                                px.cidrs_contain_ip('["162.0.128.0/17"]', remote_addr), 'US-DRN-STRETCHED-02',
                                                px.select(
                                                    px.cidrs_contain_ip('["130.1.0.0/23"]', remote_addr), 'HK-AZX-301-ADMIN',
                                                    px.select(
                                                        px.cidrs_contain_ip('["130.1.2.0/23"]', remote_addr), 'HK-AZX-301-USER',
                                                        'EXTERNAL'
                                                    )
                                                )
                                            )
                                        )
                                    )
                                )
                            )
                        )
                    )
                )
            )
        )
    )


def outbound_conns(start_time: str, ip_filter: str, filter_internal: bool):
    df = px.DataFrame(table='conn_stats', start_time=start_time)

    df.namespace = df.ctx['namespace']
    df.pod = df.ctx['pod']

    # Filter for outbound traffic only.
    # Trace-role of 1 means client-side tracing. Pixie only traces
    # on the client side when traffic is leaving the cluster.
    df = df[df.trace_role == 1]

    # Filter out any client-side tracing to known pods/services.
    df.remote_pod_id = px.ip_to_pod_id(df.remote_addr)
    df.remote_service_id = px.ip_to_service_id(df.remote_addr)
    df = df[df.remote_pod_id == '' and df.remote_service_id == '']

    # Filter out connections to localhost.
    df = df[not df.remote_addr == '127.0.0.1']
    df = df[not df.remote_addr == '0.0.0.0']

    # Label each connection with its corporate network name (or 'EXTERNAL').
    df.network_name = label_network(df.remote_addr)

    # Optionally filter out all known internal corporate networks,
    # leaving only truly external traffic.
    df = df[not filter_internal or not px.cidrs_contain_ip(internal_cidrs, df.remote_addr)]

    # Apply user supplied filter.
    df = df[px.contains(df.remote_addr, ip_filter)]

    # Calculate connection stats for each process for each unique pod / remote_addr pair.
    df = df.groupby(['pod', 'upid', 'remote_addr', 'remote_port', 'network_name']).agg(
        conn_open_min=('conn_open', px.min),
        conn_open_max=('conn_open', px.max),
        bytes_sent_min=('bytes_sent', px.min),
        bytes_sent_max=('bytes_sent', px.max),
        bytes_recv_min=('bytes_recv', px.min),
        bytes_recv_max=('bytes_recv', px.max),
        last_activity_time=('time_', px.max)
    )

    # Calculate connection stats over the time window.
    df.conn_open = df.conn_open_max - df.conn_open_min
    df.bytes_sent = df.bytes_sent_max - df.bytes_sent_min
    df.bytes_recv = df.bytes_recv_max - df.bytes_recv_min

    # Consolidate multiple processes per pod.
    df = df.groupby(['pod', 'remote_addr', 'remote_port', 'network_name']).agg(
        conn_open=('conn_open', px.sum),
        bytes_sent=('bytes_sent', px.sum),
        bytes_recv=('bytes_recv', px.sum),
        last_activity_time=('last_activity_time', px.max)
    )

    return df[['pod', 'remote_addr', 'remote_port', 'network_name', 'conn_open',
               'bytes_sent', 'bytes_recv', 'last_activity_time']]
